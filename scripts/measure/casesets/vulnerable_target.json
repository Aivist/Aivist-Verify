    {"id": "X-MASS-SAFE-PRESENT", "ground_truth": "SECURE", "shape": "mass_assignment",
     "method": "PATCH", "baseline_path": "/api/users/1/subscription", "body": {"plan": "$UNIQUE", "role": "admin"},
     "payload": {"location": "path_segment", "target_param": "1", "payload_string": "2", "type": "MASS_ASSIGNMENT"},
     "baseline_final_not": "verified", "baseline_channel": "cross_resource_readback_not_decisive"},

