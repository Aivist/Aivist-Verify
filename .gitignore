# ==============================================================================
# Aivist Verify — Git ignore rules
# ==============================================================================

# --- Secrets / local config (NEVER commit) ---
.env
backend/.env
*.env
!.env.example
!backend/.env.example
frontend/.env.local

# --- Local SQLite database + WAL sidecars ---
*.db
*.db-wal
*.db-shm
security_platform.db*
fresh.db*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Node / frontend ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.local

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log

# --- Audit / measurement artifacts (throwaway evidence — never commit) ---
# Transcripts and one-off run drivers under scripts/audit/ are measurement harnesses
# and raw evidence (they embed full AI transcripts and captured response bodies), not
# product code. Excluding them was previously a MANUAL step on every commit; these rules
# make it enforced.
#
# NOTE: the already-tracked provenance scripts (capture_*.py and shadow_p0_run.py) stay
# tracked — they are cited as byte-verification provenance in the benchmark. A .gitignore
# rule does not untrack an already-tracked file, so `shadow_p0_run.py` is unaffected.
scripts/audit/*.out.txt
scripts/audit/shadow_*.py

# --- Node-to-node handoff notes (kept local, not pushed) ---
# Candid node-to-node handoff / strategic-continuity notes live here and stay off the
# public remote. A .gitignore rule does not untrack an already-tracked file, so files
# moved in here are also `git rm --cached`-ed in the same commit (they remain on disk).
docs/handoffs/

# --- Excluded from the public release (kept locally, not uploaded) ---
# Internal / pre-publication docs and docs tied to the removed FastAPI server layer.
# These were `git rm --cached`-ed (they remain on disk). A .gitignore rule does not
# untrack an already-tracked file, so the cache removal is what actually excludes them.
docs/API_REFERENCE.md
docs/HUNTER_PIPELINE.md
docs/AUDIT.md
docs/audit/
docs/STATUS.md
docs/ROADMAP.md
docs/TECH_DEBT.md
docs/DATA_MODEL.md
.agents/skills/
