# ==============================================================================
# Commercial-Grade AI Penetration Testing & Vulnerability Audit Platform
# Global Configuration Environment Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env" in the same directory.
# 2. Fill in the parameters with values suitable for your local machine or server.
# 3. DO NOT commit the actual ".env" file containing real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Web Server Configurations (FastAPI Layer)
# ------------------------------------------------------------------------------
# API_PORT: The network port on which the FastAPI application will listen.
# Expected: Integer (1-65535). Default: 8000
API_PORT=8000

# API_HOST: Network interface the server binds to.
#   0.0.0.0   -> all interfaces (teammates on your network can reach the URL). DEFAULT.
#   127.0.0.1 -> localhost only (this machine), the safest option.
# SECURITY: there is no authentication yet, so 0.0.0.0 exposes the API to your
# whole network. Only use it on a trusted network and stop the server when done.
# API_HOST=0.0.0.0

# LOG_LEVEL: Standard logging level for structured application output.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO
LOG_LEVEL=INFO

# CORS_ALLOWED_ORIGINS: Comma-separated list of browser domains allowed to request our API.
# Mitigates CSRF and keeps frontend integration clean.
# Default: http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. AI Copilot & Core Decision Layer (Google Gemini API)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: The authentic API Key issued by Google AI Studio.
# Required for vulnerability context parsing, log auditing, and recommendation.
GEMINI_API_KEY=AIzaSyYourAuthenticGeminiApiKeyHere_ReplaceMe

# GEMINI_PRO_MODEL: The Gemini model identifier used for ALL AI calls
# (logic-hunt analysis + remediation patch generation).
# Default (in code): gemini-2.5-flash. Set to gemini-2.5-pro for stronger reasoning.
# GEMINI_PRO_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Scan & Fuzzing Engine Tuning Parameters
# ------------------------------------------------------------------------------

# GEMINI_BATCH_COOLDOWN_SECONDS: Cooldown (seconds) between sequential Gemini calls.
# Increase if you hit API rate limits. Default: 3
# GEMINI_BATCH_COOLDOWN_SECONDS=3

# FUZZER_HTTP_TIMEOUT_CONNECT: Outbound connect timeout for fuzzing (seconds). Default: 10.0
# FUZZER_HTTP_TIMEOUT_CONNECT=10.0

# FUZZER_HTTP_TIMEOUT_READ: Outbound read timeout for fuzzing (seconds). Default: 20.0
# FUZZER_HTTP_TIMEOUT_READ=20.0

# FUZZER_RESPONSE_BODY_MAX_LENGTH: Max chars kept from HTTP response body. Default: 5000
# FUZZER_RESPONSE_BODY_MAX_LENGTH=5000

# ------------------------------------------------------------------------------
# 5. AI Deep Verifier — endpoint catalog source (shadow mode, D18/D21)
# ------------------------------------------------------------------------------
# AI_DEEP_VERIFY_OPENAPI_SPEC: Absolute path to an OpenAPI/Swagger JSON file whose
# endpoint surface is shown to the shadow deep verifier. Optional; unset => a
# byte-identical placeholder catalog (no behavior change), and a bad/missing path
# fails safe back to that placeholder. JSON only. Observe-only — it never affects a
# verdict, and only matters when AI_DEEP_VERIFY_ENABLED + AI_DEEP_VERIFY_SHADOW are on.
# AI_DEEP_VERIFY_OPENAPI_SPEC=C:\path\to\openapi.json

# AI_DEEP_VERIFY_OWNER_AUTH: the OWNER/VICTIM credential (two-account ownership baseline).
# Everything the engine sends goes out as the ATTACKER; this is the only way for code to
# obtain an object's authentic OWNER view. Format: "Header-Name: value", or a bare
# credential which is sent as "Authorization: Bearer <value>". For the local labs:
#   vulnerable_target -> Bearer bob-token-bbbb
#   depot_target      -> Bearer bob-depot-token-bbbb
# Optional; unset => the second identity is simply absent and behavior is unchanged.
# It is NEVER used for an attack request, and nothing consumes it yet (credential channel
# only). ONE credential per deployment, NOT per finding -- see the D24 notes.
# AI_DEEP_VERIFY_OWNER_AUTH=Bearer bob-depot-token-bbbb
